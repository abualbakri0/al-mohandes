# إعدادات بوت تليجرام — انسخ هذا الملف إلى ".env" واملأ القيم

# توكن البوت من @BotFather (إلزامي)
BOT_TOKEN=123456789:AAAbbbCCCdddEEEfffGGGhhhIIIjjj

# معرفات المشرفين الرقمية (مفصولة بفاصلة) — احصل على معرّفك من @userinfobot (إلزامي للأوامر الإدارية)
ADMIN_IDS=123456789

# اسم التطبيق المعروض في الرسائل (اختياري)
APP_NAME=المهندس

# رابط نسخة الآيفون = رابط موقع Vercel المستضاف — يُعرض عند اختيار "آيفون"
# مثال: IOS_URL=https://al-mohandes-app-2026.vercel.app
IOS_URL=https://al-mohandes-app-2026.vercel.app

# رابط تنزيل خارجي بديل يُستخدم إن لم يوجد ملف APK محلي (اختياري)
# DOWNLOAD_URL=https://example.com/app.apk

# وصف البوت (يظهر في صفحة المحادثة) — اختياري، الافتراضي هو الوصف الرسمي:
# تطبيق المهندس - البوابة الأكاديمية والتقنية لطلاب هندسة الميكاترونكس والهندسة الكهربائية
# 📌 المطور: المهندس أبوبكر الحيدري (أبو شنب)
# BOT_DESCRIPTION=...

# الوصف المختصر (يظهر في نتائج البحث — حد أقصى 120 حرفاً) (اختياري)
# BOT_SHORT_DESCRIPTION=...
