# بوت المهندس — حاوية تشغيل دائمة (24/7)
# البوت مكتوب بـ Node.js خالص بدون أي اعتماديات خارجية،
# لذا لا حاجة لأي خطوة npm install — فقط تشغيل bot.mjs.
FROM node:20-alpine

WORKDIR /app

# نسخ ملفات البوت
COPY . .

# منفذ غير مطلوب (long polling)، لكن نعرّف بيئة الإنتاج
ENV NODE_ENV=production

# إعادة التشغيل التلقائية عند أي توقّف مفاجئ (حتى داخل الحاوية)
CMD ["node", "bot.mjs"]
